---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <div class="page">
        <aside class="sidebar">
            <Header />
            <Footer />
        </aside>

        <main class="content">
            <slot />
        </main>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
  }

  :global(html){
    scroll-behavior: smooth;
  }

  :global(body) {
    overflow: hidden;
  }

  .page {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    height: 100dvh;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding: 32px;
    background-color: #202020;
    color: white;
  }

  .content {
    min-width: 0;
    height: 100dvh;
    padding: 48px;
    overflow-y: auto;
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
  }

  @media (max-width: 700px) {
    :global(body) {
      overflow: auto;
    }

    .page {
      display: block;
      height: auto;
    }

    .sidebar {
      height: auto;
      min-height: 0;
      padding: 20px;
    }

    .content {
      height: auto;
      padding: 24px;
      overflow: visible;
      scroll-behavior: smooth;
      scroll-snap-type: none;
    }
  }
</style>
