			<span>TypeScript</span>
		</li>
		<li>
			<img src="/icons/python.svg" alt="" />
			<span>Python</span>
		</li>
		<li>
			<img src="/icons/cpp.svg" alt="" />
			<span>C++</span>
		</li>
		<li>
			<img src="/icons/c.svg" alt="" />
			<span>C</span>
		</li>
		<li>
			<img src="/icons/csharp.svg" alt="" />
			<span>C#</span>
		</li>
		</ul>
	</div>

	<div class="skills-category">
		<h4>Frontend</h4>
		<ul class="skills-grid">
		<li>
			<img src="/icons/html5.svg" alt="" />
			<span>HTML</span>
		</li>
		<li>
			<img src="/icons/css3.svg" alt="" />
			<span>CSS</span>
		</li>
		<li>
			<img src="/icons/astro.svg" alt="" />
			<span>Astro</span>
		</li>
		<li>
			<img src="/icons/react.svg" alt="" />
			<span>React</span>
