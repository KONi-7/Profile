            <dl class="work-info">
              <div>
                <dt>使用技術</dt>
                <dd>Unity / C#</dd>
              </div>
            </dl>

          </div>
        </article>

        <article class="work-item">
          <div class="work-image">
            <img
              src="/works/block_game.png"
              alt="works 3"
            />
          </div>

          <div class="work-description">
            <h3>Block Breaker</h3>
            <p class="work-summary">
              C++とDxLibで制作したWindows向けゲームです．
            </p>

            <p>
              当たり判定，接触位置による反射方向の変化，ゲームの状態管理
              などの実装を行いました．
            </p>

            <dl class="work-info">
              <div>
                <dt>使用技術</dt>
                <dd>C++ / DxLib / Visual Studio</dd>
              </div>
            </dl>

            <div class="work-links">
              <a href="https://github.com/KONi-7/koga_main_repository.git" target="_blank">GitHub</a>
            </div>
          </div>
        </article>

      </div>
      
    </div>
  </section>

</BaseLayout>

<style>
  section {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: 64px;
    border-bottom: 1px solid #dedede;
    scroll-snap-align: start;
  }

  .section-content {
    width: 100%;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  section.is-visible .section-content {
    opacity: 1;
    transform: translateY(0);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0 0 40px;
    font-size: clamp(2rem, 3vw, 2.5rem);
  }

  .section-heading::after {
    content: "";
    width: 80px;
    height: 2px;
    background-color: #222;
  }

.skills-section {
  margin-top: 48px;
}

.skills-section > h3 {
  margin-bottom: 28px;
  font-size: 1.2rem;
}

.skills-category {
  margin-bottom: 32px;
}

.skills-category:last-child {
  margin-bottom: 0;
}

.skills-category h4 {
  margin: 0 0 16px;
  font-size: 1rem;
  color: #555;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.skills-grid li {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 110px;
  padding: 16px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background-color: white;
}

.skills-grid img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.works-list {
  display: grid;
  gap: 80px;
}

.work-item {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
  align-items: center;
  gap: 48px;
}

.work-image img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid #ddd;
  border-radius: 12px;
}

.work-description h3 {
  margin: 0 0 12px;
  font-size: 1.6rem;
}

.work-summary {
  font-weight: 600;
}

.work-info div {
  display: grid;
  grid-template-columns: 80px 1fr;
  margin-top: 12px;
}

.work-info dt {
  color: #666;
}

.work-info dd {
  margin: 0;
}

.work-links {
  display: flex;
  gap: 16px;
  margin-top: 24px;
}

  @media (max-width: 700px) {
    section {
      padding: 48px 24px;
    }

	.skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

      .work-item {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll("section");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      }
    },
    {
      threshold: 0.2,
    },
  );

  for (const section of sections) {
    observer.observe(section);
  }
</script>
