---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="My Profile">
  <section id="home">
    <div class="section-content">
      <h1 class="section-heading">Home</h1>
      <p>Welcome to my portfolio</p>

      <h1>西浦 昊河</h1>

      <p>
        Web開発を勉強している大学生です．
      </p>

      <p>
        AIを活用して色々なことに取り組んでいます．
      </p>
    </div>
  </section>

  <section id="about">
    <div class="section-content">

      <h2 class="section-heading">About</h2>
      <p>名前：西浦 昊河 (Nishiura Koga)</p>
	  <p>大学：豊橋技術科学大学 情報・知能工学課程 3年</p>
	  <p>趣味：音楽，筋トレ</p>
	  <h3>興味のある分野</h3>
	  <ul>
		<li>Web開発</li>
		<li>UI・UXデザイン</li>
		<li>ゲーム開発</li>
		<li>AI・機械学習</li>
	  </ul>

	<div class="skills-section">
	<h3>Technologies</h3>

	<div class="skills-category">
		<h4>Languages</h4>
		<ul class="skills-grid">
		<li>
			<img src="/icons/javascript.svg" alt="" />
			<span>JavaScript</span>
		</li>
		<li>
			<img src="/icons/typescript.svg" alt="" />
			<span>TypeScript</span>
		</li>
		<li>
			<img src="/icons/python.svg" alt="" />
			<span>Python</span>
		</li>
		<li>
			<img src="/icons/cpp.svg" alt="" />
			<span>C++</span>
		</li>
		<li>
			<img src="/icons/c.svg" alt="" />
			<span>C</span>
		</li>
		<li>
			<img src="/icons/csharp.svg" alt="" />
			<span>C#</span>
		</li>
		</ul>
	</div>

	<div class="skills-category">
		<h4>Frontend</h4>
		<ul class="skills-grid">
		<li>
			<img src="/icons/html5.svg" alt="" />
			<span>HTML</span>
		</li>
		<li>
			<img src="/icons/css3.svg" alt="" />
			<span>CSS</span>
		</li>
		<li>
			<img src="/icons/astro.svg" alt="" />
			<span>Astro</span>
		</li>
		<li>
			<img src="/icons/react.svg" alt="" />
			<span>React</span>
		</li>
		</ul>
	</div>

	<div class="skills-category">
		<h4>Tools & Platforms</h4>
		<ul class="skills-grid">
		<li>
			<img src="/icons/git.svg" alt="" />
			<span>Git</span>
		</li>
		<li>
			<img src="/icons/github.svg" alt="" />
			<span>GitHub</span>
		</li>
		<li>
			<img src="/icons/aws.svg" alt="" />
			<span>AWS</span>
		</li>
		<li>
			<img src="/icons/nodejs.svg" alt="" />
			<span>Node.js</span>
		</li>
		</ul>
	</div>
	</div>
	</div>
  </section>

  <section id="works">
    <div class="section-content">
      <h2 class="section-heading">Works</h2>
      <p>制作物を掲載します。</p>
    </div>
  </section>

  <section id="contact">
    <div class="section-content">
      <h2 class="section-heading">Contact</h2>
      <p>お問い合わせ情報です。</p>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: 64px;
    border-bottom: 1px solid #dedede;
    scroll-snap-align: start;
  }

  .section-content {
    width: 100%;
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  section.is-visible .section-content {
    opacity: 1;
    transform: translateY(0);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0 0 40px;
    font-size: clamp(2rem, 3vw, 2.5rem);
  }

  .section-heading::after {
    content: "";
    width: 80px;
    height: 2px;
    background-color: #222;
  }

.skills-section {
  margin-top: 48px;
}

.skills-section > h3 {
  margin-bottom: 28px;
  font-size: 1.2rem;
}

.skills-category {
  margin-bottom: 32px;
}

.skills-category:last-child {
  margin-bottom: 0;
}

.skills-category h4 {
  margin: 0 0 16px;
  font-size: 1rem;
  color: #555;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.skills-grid li {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 110px;
  padding: 16px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background-color: white;
}

.skills-grid img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

  @media (max-width: 700px) {
    section {
      padding: 48px 24px;
    }

	.skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll("section");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      }
    },
    {
      threshold: 0.2,
    },
  );

  for (const section of sections) {
    observer.observe(section);
  }
</script>
