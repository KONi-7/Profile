		<li>
			<img src="/icons/git.svg" alt="" />
			<span>Git</span>
		</li>
		<li>
			<img src="/icons/github.svg" alt="" />
			<span>GitHub</span>
		</li>
		<li>
			<img src="/icons/aws.svg" alt="" />
			<span>AWS</span>
		</li>
		<li>
